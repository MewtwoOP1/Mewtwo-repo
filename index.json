{
  "name": "Zangetsu Community Sources",
  "description": "Community-maintained Zangetsu providers. These sources do not host video files.",
  "sources": [
    {
      "id": "tmdb-stremio",
      "name": "TMDB + Stremio",
      "version": "3.0.0",
      "type": "movie",
      "lang": "en",
      "file": "providers/tmdb-stremio.js",
      "logo": "https://www.google.com/s2/favicons?sz=256&domain=themoviedb.org",
      "nsfw": false,
      "settings": [
        {
          "key": "tmdbApiKey",
          "label": "TMDB API Key (optional; blank uses app default)",
          "description": "Your personal TMDB v3 API key. Leave blank to use Zangetsu’s built-in key. Sent only to TMDB.",
          "type": "text",
          "default": ""
        },
        {
          "key": "addonUrls",
          "label": "Stremio Add-on URLs (manifest URLs; comma/newline separated)",
          "description": "One or more Stremio-compatible add-on manifest URLs. Add-ons provide streams; this repository does not host video.",
          "type": "text",
          "default": ""
        },
        {
          "key": "maxStreamsPerAddon",
          "label": "Max streams per add-on (limit results from each add-on)",
          "description": "Maximum number of streams considered per configured add-on.",
          "type": "enum",
          "default": "25",
          "options": [
            {
              "value": "5",
              "label": "5 streams"
            },
            {
              "value": "10",
              "label": "10 streams"
            },
            {
              "value": "25",
              "label": "25 streams"
            },
            {
              "value": "50",
              "label": "50 streams"
            },
            {
              "value": "100",
              "label": "100 streams"
            }
          ]
        }
      ]
    },
