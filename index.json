{
  "name": "𝑴𝒆𝒘𝒕𝒘𝒐♡ Repo",
  "description": "𝑴𝒆𝒘𝒕𝒘𝒐♡ community sources for Zangetsu. Third-party provider integrations; this repository does not host video files.",
  "sources": [
    {
      "id": "aiostreams",
      "name": "AIOStreams",
      "version": "2.2.0",
      "type": "movie",
      "lang": "en",
      "file": "providers/aiostreams.js",
      "logo": "https://aiostreams.viren070.me/logo.png",
      "nsfw": false,
      "settings": [
        {
          "key": "manifestUrl",
          "label": "AIOStreams Manifest URL (required)",
          "description": "Personalized URL ending in /stremio/<id>/<config>/manifest.json.",
          "type": "text",
          "default": ""
        },
        {
          "key": "userDataBase64",
          "label": "Optional AIOStreams UserData (base64)",
          "description": "Optional x-aiostreams-user-data value. When provided, it takes precedence over Basic authentication.",
          "type": "text",
          "default": ""
        },
        {
          "key": "tmdbApiKey",
          "label": "TMDB API key or Read Access Token (optional)",
          "description": "Leave blank to use Zangetsu’s built-in TMDB key. Or provide your own v3 API key or Read Access Token.",
          "type": "text",
          "default": ""
        },
        {
          "key": "showP2P",
          "label": "Show torrent / P2P streams",
          "description": "Enable only if your Zangetsu player supports magnet links.",
          "type": "bool",
          "default": false
        },
        {
          "key": "maxConcurrentRequests",
          "label": "Maximum concurrent requests",
          "description": "Maximum simultaneous requests. Playback lookups move ahead of queued metadata requests.",
          "type": "enum",
          "default": "5",
          "options": [
            {
              "value": "2",
              "label": "2 requests"
            },
            {
              "value": "3",
              "label": "3 requests"
            },
            {
              "value": "4",
              "label": "4 requests"
            },
            {
              "value": "5",
              "label": "5 requests"
            }
          ]
        },
        {
          "key": "requestTimeoutMs",
          "label": "TMDB request timeout",
          "description": "Timeout for an individual TMDB metadata request.",
          "type": "enum",
          "default": "5000",
          "options": [
            {
              "value": "3000",
              "label": "3 seconds"
            },
            {
              "value": "5000",
              "label": "5 seconds"
            },
            {
              "value": "7000",
              "label": "7 seconds"
            },
            {
              "value": "10000",
              "label": "10 seconds"
            }
          ]
        },
        {
          "key": "streamTimeoutMs",
          "label": "AIOStreams request timeout",
          "description": "Maximum wait for each AIOStreams stream search, including anime ID fallback searches.",
          "type": "enum",
          "default": "9000",
          "options": [
            {
              "value": "4000",
              "label": "4 seconds"
            },
            {
              "value": "5000",
              "label": "5 seconds"
            },
            {
              "value": "7000",
              "label": "7 seconds"
            },
            {
              "value": "9000",
              "label": "9 seconds"
            }
          ]
        },
        {
          "key": "totalTimeoutMs",
          "label": "Total stream lookup deadline",
          "description": "Hard maximum wait for TMDB lookup, anime ID mapping, fallback searches, and waiting for a request slot.",
          "type": "enum",
          "default": "12000",
          "options": [
            {
              "value": "5000",
              "label": "5 seconds"
            },
            {
              "value": "8000",
              "label": "8 seconds"
            },
            {
              "value": "10000",
              "label": "10 seconds"
            },
            {
              "value": "12000",
              "label": "12 seconds"
            }
          ]
        }
      ]
    },
    {
      "id": "tmdb-stremio",
      "name": "TMDB + Stremio",
      "version": "3.3.0",
      "type": "movie",
      "lang": "en",
      "file": "providers/tmdb-stremio.js",
      "logo": "https://www.google.com/s2/favicons?sz=256&domain=strem.io",
      "nsfw": false,
      "settings": [
        {
          "key": "tmdbApiKey",
          "label": "TMDB API Key (optional; blank uses app default)",
          "description": "Your personal TMDB v3 API key. Leave blank to use Zangetsu’s built-in key. Sent only to TMDB.",
          "type": "text",
          "default": ""
        },
        {
          "key": "addonUrls",
          "label": "Streaming Add-on URLs (manifest URLs; comma/newline separated)",
          "description": "Stremio-compatible add-on manifest URLs used to fetch playback streams. Keep each add-on’s required URL path and token intact.",
          "type": "text",
          "default": ""
        },
        {
          "key": "metadataAddonUrls",
          "label": "Metadata Add-on URLs (manifest URLs; comma/newline separated)",
          "description": "Optional separate add-ons for catalogue rows and title metadata. If blank, catalogue lookup falls back to Streaming Add-on URLs for backwards compatibility.",
          "type": "text",
          "default": ""
        },
        {
          "key": "enableAddonCatalogs",
          "label": "Use metadata add-on catalogues",
          "description": "When enabled, browse catalogues from Metadata Add-on URLs and prefer their metadata for those titles. Disable to use TMDB catalogues only.",
          "type": "bool",
          "default": false
        },
        {
          "key": "showP2P",
          "label": "Show torrent / P2P streams",
          "description": "Allow magnet and infoHash results from configured add-ons. Enable only if the Zangetsu player supports torrent links.",
          "type": "bool",
          "default": false
        },
        {
          "key": "maxStreamsPerAddon",
          "label": "Max streams per add-on (limit results from each add-on)",
          "description": "Maximum number of streams considered per configured add-on.",
          "type": "enum",
          "default": "25",
          "options": [
            {
              "value": "5",
              "label": "5 streams"
            },
            {
              "value": "10",
              "label": "10 streams"
            },
            {
              "value": "25",
              "label": "25 streams"
            },
            {
              "value": "50",
              "label": "50 streams"
            },
            {
              "value": "100",
              "label": "100 streams"
            }
          ]
        }
      ]
    },
