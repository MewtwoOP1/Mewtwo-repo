{
  "name": "Zangetsu Extensions",
  "description": "Separate TMDB metadata and Stremio stream sources for Zangetsu.",
  "sources": [
    {
      "id": "tmdb-metadata",
      "name": "TMDB Metadata",
      "version": "1.0.0",
      "type": "movie",
      "lang": "en",
      "file": "providers/tmdb-metadata.js",
      "logo": "https://www.themoviedb.org/assets/2/v4/logos/round.svg",
      "nsfw": false,
      "settings": []
    },
    {
      "id": "stremio-bridge",
      "name": "Stremio Stream Bridge",
      "version": "2.0.0",
      "type": "movie",
      "lang": "en",
